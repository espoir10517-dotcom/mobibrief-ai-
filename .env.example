# MobiBrief AI 환경변수 예시
# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채워 넣으세요.  (cp .env.example .env)
# .env 파일은 절대 GitHub 등에 올리지 마세요. (.gitignore 에 이미 제외되어 있습니다)
# 실제 운영에서는 GitHub 저장소의 Settings → Secrets and variables → Actions 에 같은 이름으로 등록합니다.
# ※ 여기 있는 값들은 서버(자동 수집 작업)에서만 사용되며, 휴대폰 앱 코드에는 포함되지 않습니다.

# ── Phase 1: 필요 없음 (Demo Mode 로 바로 실행됩니다) ──

# ── 뉴스 수집 ──
# Google News RSS 와 언론사 RSS 는 키가 필요 없습니다.
# (네이버 검색 API 는 2026년 약관 변경으로 사용하지 않습니다. 코드는 남아 있어 키를 넣으면 동작은 합니다.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── (선택) AI 요약·분석 — Claude 구독과 별도 결제 ──
# Claude API — https://platform.claude.com  (API Keys 메뉴)
ANTHROPIC_API_KEY=
# 대량 평가용(저렴) / 상세 분석용 모델
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_DEEP=claude-sonnet-5-5

# ── Phase 5: 알림 ──
# Web Push 용 VAPID 키 (Phase 5 에서 생성 스크립트를 제공합니다)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# (선택) iPhone 대안 알림: 텔레그램 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
