# MobiBrief AI 환경변수 예시
# ─────────────────────────────────────────────────────────────
# 실제 운영: GitHub 저장소 → Settings → Secrets and variables → Actions → New repository secret
#            에 아래와 같은 '이름'으로 등록합니다. (값은 채팅·코드·이 파일에 절대 적지 마세요)
# PC 에서 시험할 때만: 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채웁니다. (.env 는 업로드되지 않습니다)
# 여기 값들은 자동 작업(GitHub Actions)에서만 쓰이며, 휴대폰 앱 코드에는 절대 들어가지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 뉴스 수집: 키 필요 없음 (Google News RSS + 국내 언론사 RSS) ──

# ── AI 편집 (둘 중 하나만 등록) — Claude/ChatGPT 구독과 별도 결제 ──
# Claude API  : https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# OpenAI API  : https://platform.openai.com → API keys
OPENAI_API_KEY=
# (선택) 모델 바꾸기 — 비워 두면 config/ai.json 기본값(claude-haiku-4-5) 사용
AI_MODEL_FAST=
AI_MODEL_DEEP=

# ── 휴대폰 알림 서버 (Cloudflare, 무료) ──
# 알림 서명 키(VAPID)는 '알림 서버 배포' 작업이 자동으로 만들어 Cloudflare 에 보관합니다. 따로 만들 필요 없습니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
